ervals$]</parent-name><remote-alias>Note</remote-alias><ordinal>32</ordinal><local-type>string</local-type><aggregation>Count</aggregation><contains-null>true</contains-null><attributes><attribute datatype='string' name='DebugRemoteType'>&quot;WSTR&quot;</attribute></attributes></metadata-record></metadata-records></connection><aliases enabled='yes' /><column datatype='integer' name="[Year]" role='dimension' type='ordinal'></column><column datatype='date' name="[Date]" role='dimension' type='nominal' /><column datatype='datetime' name="[Date and Time]" role='dimension' type='nominal' /><column datatype='string' name="[Day of Week]" role='dimension' type='nominal' /><column datatype='string' name="[Time Logged]" role='dimension' type='nominal' /><column datatype='string' name="[Interval]" role='dimension' type='nominal' /><column caption="Arrival window" datatype='integer' name="[Interval Order]" role='dimension' type='ordinal'><aliases><alias key='1' value="Before 6:00" /><alias key='2' value="6:00–6:30" /><alias key='3' value="6:30–7:00" /><alias key='4' value="7:00–7:30" /><alias key='5' value="7:30–8:00" /><alias key='6' value="8:00–8:15" /></aliases></column><column datatype='integer' name="[Interval Minutes]" role='measure' type='quantitative' /><column caption="Kids" datatype='integer' name="[Count]" role='measure' type='quantitative' /><column datatype='real' name="[Kids per 15 Min]" role='measure' type='quantitative' /><column datatype='real' name="[Share of Night]" role='measure' type='quantitative' /><column datatype='integer' name="[Arrival Minute]" role='measure' type='quantitative' /><column datatype='real' name="[Sun Altitude Deg]" role='measure' type='quantitative' /><column datatype='string' name="[Light]" role='dimension' type='nominal' /><column datatype='integer' name="[Minutes After Sunset]" role='measure' type='quantitative' /><column datatype='real' name="[Interval Temp F]" role='measure' type='quantitative' /><column datatype='real' name="[Interval Feels Like F]" role='measure' type='quantitative' /><column datatype='real' name="[Interval Precip In]" role='measure' type='quantitative' /><column datatype='real' name="[Interval Wind Mph]" role='measure' type='quantitative' /><column datatype='string' name="[Night Type]" role='dimension' type='nominal' /><column datatype='integer' name="[Year Total]" role='measure' type='quantitative' /><column datatype='string' name="[COVID Year]" role='dimension' type='nominal' /><column datatype='real' name="[Night Temp F]" role='measure' type='quantitative' /><column datatype='real' name="[Night Feels Like F]" role='measure' type='quantitative' /><column datatype='real' name="[Night Precip In]" role='measure' type='quantitative' /><column datatype='string' name="[Rain or Dry]" role='dimension' type='nominal' /><column datatype='real' name="[Night Max Wind Mph]" role='measure' type='quantitative' /><column datatype='real' name="[Night Max Gust Mph]" role='measure' type='quantitative' /><column datatype='integer' name="[Night Cloud Cover Pct]" role='measure' type='quantitative' /><column datatype='string' name="[Conditions]" role='dimension' type='nominal' /><column datatype='string' name="[Temperature Band]" role='dimension' type='nominal' /><column datatype='string' name="[Sunset EDT]" role='dimension' type='nominal' /><column datatype='string' name="[Note]" role='dimension' type='nominal' /><column caption="Rain night average" datatype='real' name="[Calculation_RainAvg]" role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IF [Rain or Dry] = "Rain" THEN [Count] END) / COUNTD(IF [Rain or Dry] = "Rain" THEN [Year] END)' /></column><column caption="Dry night average" datatype='real' name="[Calculation_DryAvg]" role='measure' type='quantitative'><calculation class='tableau' formula='SUM(IF [Rain or Dry] = "Dry" THEN [Count] END) / COUNTD(IF [Rain or Dry] = "Dry" THEN [Year] END)' /></column><column caption="Rain nights" datatype='integer' name="[Calculation_RainN]" role='measure' type='quantitative'><calculation class='tableau' formula='COUNTD(IF [Rain or Dry] = "Rain" THEN [Year] END)' /></column><column caption="Dry nights" datatype='integer' name="[Calculation_DryN]" role='measure' type='quantitative'><calculation class='tableau' formula='COUNTD(IF [Rain or Dry] = "Dry" THEN [Year] END)' /></column><column caption="Window length" datatype='string' name="[Calculation_WindowLength]" role='measure' type='nominal'><calculation class='tableau' formula='IF ISNULL(MIN([Interval Minutes])) THEN "Open-ended early arrivals" ELSE STR(MIN([Interval Minutes])) + " min" END' /></column><column caption="Kids per 15 min label" datatype='string' name="[Calculation_RateLabel]" role='measure' type='nominal'><calculation class='tableau' formula='IF ISNULL(AVG([Kids per 15 Min])) THEN "Not applicable (open-ended window)" ELSE STR(ROUND(AVG([Kids per 15 Min]), 1)) END' /></column><column caption="Key year label" datatype='string' name="[Calculation_YearLabel]" role='dimension' type='nominal'><calculation class='tableau' formula='IF [Year] = 2011 OR [Year] = 2013 OR [Year] = 2017 OR [Year] = 2019 THEN STR([Year]) ELSE "" END' /></column><column caption="Keep Year?" datatype='boolean' name="[Calculation_KeepYear]" role='dimension' type='nominal'><calculation class='tableau' formula='[Parameters].[Parameter 1] = "Include 2020" OR [Year] &lt;&gt; 2020' /></column><column caption="Kids per Night" datatype='real' name="[Calculation_KidsPerNight]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Count]) / COUNTD([Year])" /></column><column caption="Share of All Kids" datatype='real' name="[Calculation_Share]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Count]) / MIN({ FIXED [Calculation_KeepYear] : SUM([Count]) })" /></column><column caption="Peak Hour Share" datatype='real' name="[Calculation_PeakShare]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [Interval Order] = 3 OR [Interval Order] = 4 THEN [Count] END) / SUM([Count])" /></column><column caption="Rain vs Dry" datatype='real' name="[Calculation_RainEffect]" role='measure' type='quantitative'><calculation class='tableau' formula='(SUM(IF [Rain or Dry] = "Rain" THEN [Count] END) / COUNTD(IF [Rain or Dry] = "Rain" THEN [Year] END))&#10;/ (SUM(IF [Rain or Dry] = "Dry" THEN [Count] END) / COUNTD(IF [Rain or Dry] = "Dry" THEN [Year] END)) - 1' /></column><column caption="Avg Arrival (min after 6 pm)" datatype='real' name="[Calculation_ArrMin]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Count] * [Arrival Minute]) / SUM([Count])" /></column><column caption="Avg Arrival Time" datatype='string' name="[Calculation_ArrTime]" role='measure' type='nominal'><calculation class='tableau' formula='STR(6 + INT(INT(ROUND([Calculation_ArrMin], 0)) / 60)) + ":" + RIGHT("0" + STR(INT(ROUND([Calculation_ArrMin], 0)) % 60), 2) + " pm"' /></column><column caption="Year grouping" datatype='string' name="[Calculation_ColorBy]" role='dimension' type='nominal'><calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN "Rain or dry" THEN [Rain or Dry]&#10;WHEN "Temperature" THEN [Temperature Band]&#10;ELSE [Night Type]&#10;END' /></column><column caption="Selected Weather" datatype='real' name="[Calculation_Weather]" role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN "Wind gust (mph)" THEN AVG([Night Max Gust Mph])&#10;WHEN "Wind speed (mph)" THEN AVG([Night Max Wind Mph])&#10;WHEN "Rain 6-8 pm (in)" THEN AVG([Night Precip In])&#10;WHEN "Feels-like temp (F)" THEN AVG([Night Feels Like F])&#10;ELSE AVG([Night Cloud Cover Pct])&#10;END' /></column><column caption="Year Total (LOD)" datatype='integer' name="[Calculation_YearTotal]" role='measure' type='quantitative'><calculation class='tableau' formula="{ FIXED [Year] : SUM([Count]) }" /></column><column-instance column="[Rain or Dry]" derivation='None' name="[none:Rain or Dry:nk]" pivot='key' type='nominal' /><column-instance column="[Light]" derivation='None' name="[none:Light:nk]" pivot='key' type='nominal' /><column-instance column="[Calculation_ColorBy]" derivation='None' name="[none:Calculation_ColorBy:nk]" pivot='key' type='nominal' /><layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' /><style><style-rule element='mark'><encoding attr='color' field="[none:Rain or Dry:nk]" type='palette'><map to='#2F7FC1'><bucket>"Rain"</bucket></map><map to='#C27A28'><bucket>"Dry"</bucket></map></encoding><encoding attr='color' field="[none:Light:nk]" type='palette'><map to='#BBA8E0'><bucket>"Daylight"</bucket></map><map to='#8566BE'><bucket>"Twilight"</bucket></map><map to='#4A2F7A'><bucket>"Dark"</bucket></map></encoding><encoding attr='color' field="[none:Calculation_ColorBy:nk]" type='palette'><map to='#2F7FC1'><bucket>"Rain"</bucket></map><map to='#C27A28'><bucket>"Dry"</bucket></map><map to='#3F86C8'><bucket>"Chilly (&lt; 50°F)"</bucket></map><map to='#B98512'><bucket>"Mild (50–59°F)"</bucket></map><map to='#C8424F'><bucket>"Warm (60°F +)"</bucket></map><map to='#5B3F8C'><bucket>"School night (Sun–Thu)"</bucket></map><map to='#E0570B'><bucket>"Weekend night (Fri/Sat)"</bucket></map></encoding></style-rule></style><semantic-values><semantic-value key='[Country].[Name]' value='&quot;United States&quot;' /></semantic-values><datasource-dependencies datasource='Parameters'><column caption="2020 (COVID year)" datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='"Exclude 2020"'><calculation class='tableau' formula='"Exclude 2020"' /><members><member value='"Exclude 2020"' /><member value='"Include 2020"' /></members></column><column caption="Color years by" datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='"Rain or dry"'><calculation class='tableau' 