alue='true' /></style-rule></style></pane></panes><rows></rows><cols></cols></table><simple-id uuid="{7AAAF92B-42DB-5180-838A-FCF1DD10113C}" /></worksheet><worksheet name="KPI Arrival Time"><table><view><datasources><datasource caption='Halloween Data' name='federated.0hw2026trickortreatweather01' /></datasources><datasource-dependencies datasource='federated.0hw2026trickortreatweather01'><column caption="Avg Arrival Time" datatype='string' name="[Calculation_ArrTime]" role='measure' type='nominal'><calculation class='tableau' formula='STR(6 + INT(INT(ROUND([Calculation_ArrMin], 0)) / 60)) + ":" + RIGHT("0" + STR(INT(ROUND([Calculation_ArrMin], 0)) % 60), 2) + " pm"' /></column><column caption="Avg Arrival (min after 6 pm)" datatype='real' name="[Calculation_ArrMin]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Count] * [Arrival Minute]) / SUM([Count])" /></column><column caption="Keep Year?" datatype='boolean' name="[Calculation_KeepYear]" role='dimension' type='nominal'><calculation class='tableau' formula='[Parameters].[Parameter 1] = "Include 2020" OR [Year] &lt;&gt; 2020' /></column><column datatype='integer' name="[Arrival Minute]" role='measure' type='quantitative' /><column caption="Kids" datatype='integer' name="[Count]" role='measure' type='quantitative' /><column datatype='integer' name="[Year]" role='dimension' type='ordinal'></column><column-instance column="[Calculation_ArrTime]" derivation='User' name="[usr:Calculation_ArrTime:nk]" pivot='key' type='nominal' /><column-instance column="[Calculation_KeepYear]" derivation='None' name="[none:Calculation_KeepYear:nk]" pivot='key' type='nominal' /></datasource-dependencies><datasource-dependencies datasource='Parameters'><column caption="2020 (COVID year)" datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='"Exclude 2020"'><calculation class='tableau' formula='"Exclude 2020"' /><members><member value='"Exclude 2020"' /><member value='"Include 2020"' /></members></column></datasource-dependencies><filter class='categorical' column="[federated.0hw2026trickortreatweather01].[none:Calculation_KeepYear:nk]"><groupfilter function='member' level="[none:Calculation_KeepYear:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.0hw2026trickortreatweather01].[none:Calculation_KeepYear:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='cell'><format attr='text-align' value='center' /><format attr='vertical-align' value='center' /></style-rule><style-rule element='table'><format attr='background-color' value='#FBF8F3' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column="[federated.0hw2026trickortreatweather01].[usr:Calculation_ArrTime:nk]" /></encodings><customized-tooltip><formatted-text><run fontname='Tableau Book'>Estimated from interval midpoints, not individual arrival timestamps. Early arrivals use a representative 5:45 pm midpoint.</run></formatted-text></customized-tooltip><customized-label><formatted-text><run bold='true' fontcolor='#E8590C' fontname='Tableau Semibold' fontsize='30'>≈ </run><run bold='true' fontcolor='#E8590C' fontname='Tableau Semibold' fontsize='30'>&lt;[federated.0hw2026trickortreatweather01].[usr:Calculation_ArrTime:nk]&gt;</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book' fontsize='10'>estimated average arrival</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book' fontsize='9'>kid-weighted · interval midpoints</run></formatted-text></customized-label><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes><rows></rows><cols></cols></table><simple-id uuid="{143DB203-07D7-58D5-BA46-E837482D9D3A}" /></worksheet><worksheet name="Year 