6trickortreatweather01].[none:Calculation_KeepYear:nk]"><groupfilter function='member' level="[none:Calculation_KeepYear:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.0hw2026trickortreatweather01].[none:Calculation_KeepYear:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='cell'><format attr='text-format' field="[federated.0hw2026trickortreatweather01].[avg:Night Feels Like F:qk]" value="n#,##0.0" /><format attr='text-format' field="[federated.0hw2026trickortreatweather01].[avg:Night Precip In:qk]" value="n#,##0.00" /><format attr='text-format' field="[federated.0hw2026trickortreatweather01].[avg:Night Max Gust Mph:qk]" value="n#,##0" /></style-rule><style-rule element='table'><format attr='background-color' value='#FBF8F3' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Bar' /><encodings><color column="[federated.0hw2026trickortreatweather01].[none:Calculation_ColorBy:nk]" /><text column="[federated.0hw2026trickortreatweather01].[sum:Count:qk]" /><tooltip column="[federated.0hw2026trickortreatweather01].[attr:Day of Week:nk]" /><tooltip column="[federated.0hw2026trickortreatweather01].[attr:Conditions:nk]" /><tooltip column="[federated.0hw2026trickortreatweather01].[avg:Night Feels Like F:qk]" /><tooltip column="[federated.0hw2026trickortreatweather01].[avg:Night Precip In:qk]" /><tooltip column="[federated.0hw2026trickortreatweather01].[avg:Night Max Gust Mph:qk]" /><tooltip column="[federated.0hw2026trickortreatweather01].[attr:Note:nk]" /></encodings><reference-line axis-column="[federated.0hw2026trickortreatweather01].[sum:Count:qk]" enable-instant-analytics='false' formula='average' id='refline0' label='Overall average' label-type='custom' probability='95' scope='per-table' value-column="[federated.0hw2026trickortreatweather01].[sum:Count:qk]" z-order='1' /><customized-tooltip><formatted-text><run bold='true' fontcolor='#E8590C' fontname='Tableau Semibold' fontsize='12'>&lt;[federated.0hw2026trickortreatweather01].[none:Year:ok]&gt;</run><run fontcolor='#6E6875'>  ·  </run><run fontcolor='#2E2A33' fontname='Tableau Book'>&lt;[federated.0hw2026trickortreatweather01].[attr:Day of Week:nk]&gt;</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book'>Trick-or-treaters: </run><run bold='true' fontcolor='#2E2A33' fontname='Tableau Semibold'>&lt;[federated.0hw2026trickortreatweather01].[sum:Count:qk]&gt;</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book'>Conditions 6–8 pm: </run><run bold='true' fontcolor='#2E2A33' fontname='Tableau Semibold'>&lt;[federated.0hw2026trickortreatweather01].[attr:Conditions:nk]&gt;</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book'>Feels-like temp (°F): </run><run bold='true' fontcolor='#2E2A33' fontname='Tableau Semibold'>&lt;[federated.0hw2026trickortreatweather01].[avg:Night Feels Like F:qk]&gt;</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book'>Rain 6–8 pm (in): </run><run bold='true' fontcolor='#2E2A33' fontname='Tableau Semibold'>&lt;[federated.0hw2026trickortreatweather01].[avg:Night Precip In:qk]&gt;</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book'>Peak wind gust (mph): </run><run bold='true' fontcolor='#2E2A33' fontname='Tableau Semibold'>&lt;[federated.0hw2026trickortreatweather01].[avg:Night Max Gust Mph:qk]&gt;</run><run>Æ&#10;</run><run italic='true' fontcolor='#6E6875' fontname='Tableau Book'>&lt;[federated.0hw2026trickortreatweather01].[attr:Note:nk]&gt;</run></formatted-text></customized-tooltip><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes><rows>[federated.0hw2026trickortreatweather01].[sum:Count:qk]</rows><cols>[federated.0hw2026trickortreatweather01].[none:Year:ok]</cols></table><simple-id uuid="{41AF9D64-9D2D-5380-B21C-DD6EC7C1A893}" /></worksheet><worksheet name="Arrival Curve"><layout-options><title><formatted-text><run fontcolor='#2E2A33' fontname='Tableau Semibold' fontsize='13'>When they come: the hour after sunset</run><run>Æ&#10;</run><run fontcolor='#6E6875' fontname='Tableau Book' fontsize='9'>Kids per window · sunset ≈ 6:37 pm EDT · final window is 15 min</run><run>Æ&#10;</run><run fontcolor='#BBA8E0' fontname='Tableau Book' fontsize='9'>■</run><run fontcolor='#2E2A33' fontname='Tableau Book' fontsize='9'> Daylight    </run><run fontcolor='#8566BE' fontname='Tableau Book' fontsize='9'>■</run><run fontcolor='#2E2A33' fontname='Tableau Book' fontsize='9'> Twilight    </run><run fontcolor='#4A2F7A' fontname='Tableau Book' fontsize='9'>■</run><run fontcolor='#2E2A33' fontname='Tableau Book' fontsize='9'> Dark</run></formatted-text></title></layout-options><table><view><datasources><datasource caption='Halloween Data' name='federated.0hw2026trickortreatweather01' /></datasources><datasource-dependencies datasource='federated.0hw2026trickortreatweather01'><column caption="Kids per Night" datatype='real' name="[Calculation_KidsPerNight]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Count]) / COUNTD([Year])" /></column><column caption="Arrival window" datatype='integer' name="[Interval Order]" role='dimension' type='ordinal'><aliases><alias key='1' value="Before 6:00" /><alias key='2' value="6:00–6:30" /><alias key='3' value="6:30–7:00" /><alias key='4' value="7:00–7:30" /><alias key='5' value="7:30–8:00" /><alias key='6' value="8:00–8:15" /></aliases></column><column datatype='string' name="[Light]" role='dimension' type='nominal' /><column caption="Share of All Kids" datatype='real' name="[Calculation_Share]" role='measure' type='quantitative'><calculation class='tableau' formula="SUM([Count]) / MIN({ FIXED [Calculation_KeepYear] : SUM([Count]) })" /></column><column caption="Keep Year?" datatype='boolean' name="[Calculation_KeepYear]" role='dimension' type='nominal'><calculation class='tableau' formula='[Parameters].[Parameter 1] = "Include 2020" OR [Year] &lt;&gt; 2020' /></column><column caption="Window length" datatype='string' name="[Calculation_WindowLength]" role='measure' type='nominal'><calculation class='tableau' formula='IF ISNULL(MIN([Interval Minutes])) THEN "Open-ended early arrivals" ELSE STR(MIN([Interval Minutes])) + " min" END' /></column><column caption="Kids per 15 min label" datatype='string' name="[Calculation_RateLabel]" role='measure' type='nominal'><calculation class='tableau' formula='IF ISNULL(AVG([Kids per 15 Min])) THEN "Not applicable (open-ended window)" ELSE STR(ROUND(AVG([Kids per 15 Min]), 1)) END' /></column><column caption="Kids" datatype='integer' name="[Count]" role='measure' type='quantitative' /><column datatype='integer' name="[Interval Minutes]" role='measure' type='quantitative' /><column datatype='real' name="[Kids per 15 Min]" role='measure' type='quantitative' /><column datatype='integer' name="[Year]" role='dimension' type='ordinal'></column><column-instance column="[Calculation_KidsPerNight]" derivation='User' name="[usr:Calculation_KidsPerNight:qk]" pivot='key' type='quantitative' /><column-instance column="[Interval Order]" derivation='None' name="[none:Interval Order:ok]" pivot='key' type='ordinal' /><column-instance column="[Light]" derivation='None' name="[none:Light:nk]" pivot='key' type='nominal' /><column-instance column="[Calculation_Share]" derivation='User' name="[usr:Calculation_Share:qk]" pivot='key' type='quantitative' /><column-instance column="[Calculation_WindowLength]" derivation='User' name="[usr:Calculation_WindowLength:nk]" pivot='key' type='nominal' /><column-instance column="[Calculation_RateLabel]" derivation='User' name="[usr:Calculation_RateLabel:nk]" pivot='key' type='nominal' /><column-instance column="[Calculation_KeepYear]" derivation='None' name="[none:Calculation_KeepYear:nk]" pivot='key' type='nomi